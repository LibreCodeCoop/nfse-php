{
    "name": "librecodeoop/nfse-php-domain-tools",
    "description": "Isolated CLI tools for reproducible official NFS-e annex processing",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "phpoffice/phpspreadsheet": "^5.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LibreCodeCoop\\NfsePHP\\Tools\\": "../../tools/src/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml"
    },
    "config": {
        "sort-packages": true
    }
}
